{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PR review guide",
  "type": "object",
  "required": [
    "title",
    "intent",
    "intent_clear",
    "chapters",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "description": "PR title, or a short name for the change set."
    },
    "url": {
      "type": "string",
      "description": "PR URL, if there is one."
    },
    "intent": {
      "type": "string",
      "description": "One sentence: what the PR should do, in behavior terms."
    },
    "intent_clear": {
      "type": "boolean",
      "description": "False if the description and the diff disagree, or the purpose is unclear."
    },
    "intent_note": {
      "type": "string",
      "description": "Required when intent_clear is false: what is unclear or mismatched."
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "risk",
          "risk_reason",
          "files"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Stable slug, e.g. resolve-chat-uploads."
          },
          "title": {
            "type": "string",
            "description": "2-5 words, sentence case."
          },
          "summary": {
            "type": "string",
            "description": "1-3 sentences. Markdown links to code: [text](path/to/file.ts#L42). Inline `code` allowed."
          },
          "risk": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "risk_reason": {
            "type": "string",
            "description": "One short phrase on why this risk level."
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Repo-relative paths, in reading order. Every changed file appears in exactly one chapter."
          },
          "tour": {
            "type": "array",
            "maxItems": 8,
            "description": "Guided walkthrough of the chapter, in explaining order.",
            "items": {
              "type": "object",
              "required": [
                "file",
                "line",
                "note"
              ],
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "First line to highlight, new side of the diff."
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Last line to highlight (optional, keep ranges short)."
                },
                "note": {
                  "type": "string",
                  "description": "1-2 sentences: what this code does and what to notice. Markdown links and `code` allowed."
                }
              }
            }
          },
          "checks": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string"
            },
            "description": "Specific questions a reviewer should ask about this chapter."
          },
          "test": {
            "type": "string",
            "description": "How to try this chapter by hand, with the command or steps."
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "line",
          "severity",
          "check",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "Line number on the new side of the diff."
          },
          "severity": {
            "enum": [
              "blocker",
              "warn",
              "nit"
            ]
          },
          "check": {
            "type": "string",
            "description": "Check id from checklist.md, or 'other'."
          },
          "message": {
            "type": "string",
            "description": "The actual problem in this code, 1-2 sentences."
          },
          "suggestion": {
            "type": "string",
            "description": "Concrete fix, prose or a short code snippet."
          }
        }
      }
    }
  }
}